{
  "name": "lyrics-pdf",
  "version": "1.0.0",
  "description": "A client-side application foundation for printable song lyrics.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests vite.config.ts playwright.config.ts playwright.matrix.config.ts eslint.config.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "node scripts/playwright.mjs test",
    "test:e2e:matrix": "node scripts/playwright.mjs test --config playwright.matrix.config.ts --workers=1",
    "test:e2e:install": "node scripts/playwright.mjs install chromium",
    "test:e2e:install:matrix": "node scripts/playwright.mjs install firefox webkit"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "fontkit": "3.0.0",
    "lucide-react": "^1.81.0",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "linebreak": "2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/pdfmake": "^0.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
